@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center">
    <h1 class="display-4">¡Bienvenido a Escape del Chacho!</h1>
    <p>Ingresa tu nombre para comenzar a jugar.</p>

    <form action='@Url.Action("Iniciar", "Home")' method="POST">
        <label>Nombre del Participante:</label>
        <br />
        <input type="text" name="nombreParticipante" placeholder="Ej: Juan Perez" required />
        <br /><br />
        <input type="submit" value="Entrar" class="btn btn-primary" />
    </form>
</div>