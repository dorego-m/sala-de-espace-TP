@{
    ViewData["Title"] = "Identificación";
}

<div class="text-center">

    <h1>¿Cómo te llamás?</h1>
    <p>Ingresá tu nombre. Si ya tenías una partida en curso, la vamos a retomar donde la dejaste.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form id="formIdentificacion" asp-controller="Home" asp-action="Identificacion" method="post" class="mt-3">
        <div class="mb-3 col-md-4 mx-auto">
            <input type="text" name="nombreParticipante" id="nombreParticipante" class="form-control" placeholder="Tu nombre" />
        </div>
        <button type="submit" class="btn btn-comenzar">Entrar al container</button>
    </form>

</div>

